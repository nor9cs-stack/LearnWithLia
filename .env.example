# LearnWithLia environment template. Values below are placeholders only.
# Scope abbreviations: Development (Dev), Preview (Prev), Production (Prod).

# Required: Dev / Prev / Prod. PostgreSQL runtime URL; use the Supabase session pooler in Prev/Prod.
DATABASE_URL="postgresql://postgres:password@localhost:5432/learnwithlia"

# Optional in Dev when DATABASE_URL is direct; required for Prev/Prod migrations. Use the direct PostgreSQL URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/learnwithlia"

# Optional in Dev because a development-only fallback exists; required: Prev / Prod. Minimum 32 random bytes.
AUTH_SECRET="replace-with-at-least-32-random-bytes"

# Required: Dev / Prev / Prod. Canonical public origin used by metadata and trusted-origin checks; no trailing slash.
APP_URL="http://localhost:3000"

# Optional in Dev unless file upload is tested; required: Prev / Prod. Supabase project URL.
SUPABASE_URL="https://project-ref.supabase.co"

# Optional in Dev unless file upload is tested; required: Prev / Prod. Server-only Storage administration key.
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"

# Optional in Dev; required: Prev / Prod. Name of the private bucket used for exam source files.
SUPABASE_STORAGE_BUCKET="exam-source-files"

# Optional in Dev; required: Prev / Prod. Upstash Redis REST endpoint used by rate limiting.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"

# Optional in Dev; required: Prev / Prod. Server-only Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"

# Optional with the local Inngest dev server; required: Prev / Prod. Key used to send events to Inngest.
INNGEST_EVENT_KEY="replace-with-event-key"

# Optional with the local Inngest dev server; required: Prev / Prod. Key used by Inngest to sign endpoint requests.
INNGEST_SIGNING_KEY="replace-with-signing-key"

# Required only while running `pnpm prisma:seed`; Dev or isolated Prev/test only, never Prod. Seed OWNER password.
SEED_OWNER_PASSWORD=""
# Required only while running `pnpm prisma:seed`; Dev or isolated Prev/test only, never Prod. Seed teacher password.
SEED_TEACHER_PASSWORD=""
# Required only while running `pnpm prisma:seed`; Dev or isolated Prev/test only, never Prod. Shared seed student password.
SEED_STUDENT_PASSWORD=""

# Optional: Dev / Prev test runs. Defaults to http://127.0.0.1:3000.
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# Required only for seeded OWNER E2E; Dev or isolated Prev/test only, never Prod. Falls back to SEED_OWNER_PASSWORD.
E2E_OWNER_PASSWORD=""
# Required only for seeded teacher E2E; Dev or isolated Prev/test only, never Prod. Falls back to SEED_TEACHER_PASSWORD.
E2E_TEACHER_PASSWORD=""
# Required only for seeded student E2E; Dev or isolated Prev/test only, never Prod. Falls back to SEED_STUDENT_PASSWORD.
E2E_STUDENT_PASSWORD=""
